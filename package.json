{
  "name": "dealkart",
  "version": "1.0.0",
  "description": "DealKart - Full-Stack Product Price Comparison and Deal Discovery Platform",
  "main": "server/server.js",
  "scripts": {
    "install:all": "npm install && cd server && npm install && cd ../client && npm install",
    "seed": "node server/seed/seed.js",
    "start:server": "node server/server.js",
    "dev:server": "nodemon server/server.js",
    "dev:client": "cd client && npm run dev",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "build": "cd client && npm run build"
  },
  "keywords": ["price-comparison", "deal-discovery", "dealkart", "mern", "college-project"],
  "author": "College Project Team",
  "license": "MIT",
  "dependencies": {
    "concurrently": "^9.1.2"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  }
}
